# uv virtual environment (uv sync, scripts/setup_*)
.venv/

# Python bytecode and tool caches (pytest, ruff)
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# PyInstaller (ArenaHub.spec): build/ is its work folder, dist/ holds the onefile binary and the
# release archives written by scripts/package.py
build/
dist/

# Mod downloads left by an interrupted install into a folder inside the checkout
.arenahub-staging/

# Editors: only the shared VS Code files in .vscode/ are tracked
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Personal Claude Code files
CLAUDE.local.md
.claude/settings.local.json
