# uv: the project environment (uv sync, scripts/setup_*)
.venv/

# Python bytecode and tool caches (pytest, Ruff)
__pycache__/
.pytest_cache/
.ruff_cache/

# PyInstaller (scripts/ArenaHub.spec): build/ is its work folder; dist/ holds the onefile binary and the
# release archives written by scripts/package.py
/build/
/dist/

# Files the supported development systems drop into folders (macOS Finder, Windows Explorer)
.DS_Store
Thumbs.db
desktop.ini

# Personal Claude Code files (CLAUDE.md is shared)
CLAUDE.local.md
.claude/settings.local.json
